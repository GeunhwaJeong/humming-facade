node_modules/
.DS_Store

# 런타임 데이터 — 커밋 금지
accounts.json
media/
# 지갑 비밀키 (수탁 데모) — 절대 커밋 금지
wallet-keys.json
# JWT 서명 시크릿 (부팅 시 자동 생성) — 절대 커밋 금지
.jwt-secret

# 세션 임시 파일
*.log
accounts.mainnet.json
wallet-keys.mainnet.json
# 네트워크별 수탁 키·계정 파일 전부 (sui-testnet, sui-mainnet 등)은 이름 나열이 아니라
# 패턴으로 막는다. 새 네트워크를 추가할 때 여기를 잊으면 `git add -A` 한 번에 유저 키가 샌다.
wallet-keys.*.json
accounts.*.json

# 상태 백업 스냅샷 (런타임 생성)
backups/

# 런타임 상태 (네트워크별) — 커밋 금지
events.*.jsonl
audit.*.jsonl
indexer-cursor.*.json
pending-tx.*.jsonl
pending-signups.*.json
revoked-sessions.*.json
reports.*.jsonl
hidden-posts.*.json
